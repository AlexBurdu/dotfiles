#!/usr/bin/env bash
#
# Refuses commits that would leak machine-identifying details into this public
# repo. Installed by the top-level setup.sh via core.hooksPath, so a fresh
# clone on any machine picks it up as part of the same sync that would
# otherwise introduce the leak.
#
# Checks the staged diff for:
#   - absolute home directories (/home/<user>, /Users/<user>) — these identify
#     the machine, and are what setup scripts tend to bake into generated files
#   - email addresses that are not @gmail.com and not in allowed-emails
#   - credential-shaped strings
#   - any term listed in blocked-terms (private repo and host names — that
#     file is machine-local and untracked, since the names themselves are the
#     thing worth keeping out of a public repo)
# ...and the identity the commit would be recorded under.
#
# Bypass a false positive with `git commit --no-verify`, or add the address to
# .githooks/allowed-emails if it is a legitimate upstream credit.
set -uo pipefail

repo_root=$(git rev-parse --show-toplevel)
allow_file="$repo_root/.githooks/allowed-emails"
terms_file="$repo_root/.githooks/blocked-terms"
email_re='[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}'
status=0

lower() { printf '%s' "$1" | tr '[:upper:]' '[:lower:]'; }

# gmail is the personal identity; anything else has to be listed explicitly.
email_allowed() {
  local e
  e=$(lower "$1")
  case "$e" in
    *@gmail.com | *@users.noreply.github.com) return 0 ;;
  esac
  [ -f "$allow_file" ] || return 1
  grep -v '^[[:space:]]*#' "$allow_file" | tr '[:upper:]' '[:lower:]' | grep -qxF "$e"
}

# Staged added lines, as file:lineno:content. The hook directory is skipped:
# it necessarily contains the very patterns it searches for.
added=$(git diff --cached -U0 --no-color --diff-filter=ACMR | awk '
  /^\+\+\+ / { path = substr($0, 7); next }
  /^@@ /     { h = $3; sub(/^\+/, "", h); split(h, p, ","); ln = p[1]; next }
  /^\+/      { print path ":" ln ":" substr($0, 2); ln++ }
' | grep -v '^\.githooks/' || true)

report() {
  printf '\n  %s\n' "$1"
  printf '%s\n' "$2" | cut -c1-140 | sed 's/^/    /'
  status=1
}

scan() {
  local hits
  hits=$(printf '%s\n' "$added" | grep -E "$2" || true)
  [ -n "$hits" ] && report "$1" "$hits"
  return 0
}

if [ -n "$added" ]; then
  scan 'absolute home directory (identifies the machine):' \
    '/(home|Users)/[A-Za-z][A-Za-z0-9._-]*'

  scan 'credential-shaped string:' \
    '(gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,}|sk-[A-Za-z0-9_-]{20,}|AKIA[0-9A-Z]{16}|xox[abposr]-[A-Za-z0-9-]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY-----)'

  scan 'credential assignment:' \
    '(password|passwd|api[_-]?key|secret|token)[[:space:]]*[=:][[:space:]]*["'"'"'][^"'"'"']{8,}'

  # Machine-local terms: private repo names, host names, anything else that
  # should not appear here. Comments and blank lines are ignored.
  if [ -f "$terms_file" ]; then
    terms=$(grep -v '^[[:space:]]*#' "$terms_file" | grep -v '^[[:space:]]*$' || true)
    if [ -n "$terms" ]; then
      scan 'blocked term:' "$(printf '%s' "$terms" | paste -sd '|' -)"
    fi
  fi

  # Emails need per-address judgement, so they cannot be a plain grep.
  email_hits=""
  while IFS= read -r line; do
    [ -n "$line" ] || continue
    for addr in $(printf '%s' "$line" | grep -oE "$email_re"); do
      if ! email_allowed "$addr"; then
        email_hits="$email_hits$line
"
        break
      fi
    done
  done < <(printf '%s\n' "$added" | grep -E "$email_re" || true)
  [ -n "$email_hits" ] && report 'non-personal email address:' "$(printf '%s' "$email_hits" | sort -u)"
fi

# The identity the commit would be recorded under.
committer=$(git config user.email || true)
if [ -z "$committer" ]; then
  printf '\n  no user.email configured for this repo\n'
  status=1
elif ! email_allowed "$committer"; then
  printf '\n  committing as %s, which is not a personal address\n' "$committer"
  printf '    git config user.email you@gmail.com\n'
  status=1
fi

if [ "$status" -ne 0 ]; then
  printf '\npre-commit: blocked — this is a public repo.\n'
  printf 'Fix the above, allowlist it in .githooks/allowed-emails, or use --no-verify.\n\n'
fi

exit "$status"
