/.DS_Store
.DS_Store

# Midnight Commander runtime state — MC rewrites these on exit and
# set-themes.sh seds the skin into ini. Seeded from mc/ini.template.
mc/ini
mc/ini-e
mc/panels.ini

# Neovim
nvim/lazy-lock.json
__pycache__/

# Machine-local nvim plugin overlay (never committed)
nvim/lua/plugins/local/

# Machine-local commit-guard terms — the names are the thing being protected
.githooks/blocked-terms

# Claude Code per-machine permission grants. These accumulate absolute paths,
# private repo and branch names as you approve tool calls. Ignored globally in
# ~/.config/git/ignore too, but that is machine-local — a fresh clone
# elsewhere would not have it, and this is a public repo.
**/.claude/settings.local.json
