# Ghostty Configuration

# Theme
theme = light:catppuccin-latte.conf,dark:catppuccin-mocha.conf

# Font
font-family = "JetBrainsMono Nerd Font Mono"
font-family = "Symbols Nerd Font"
font-size = 16

# Keyboard
macos-option-as-alt = true

# Window
# window-padding-x = 10
# window-padding-y = 10

# Config from outside this repo — work settings kept in another version
# control, linked to ~/.config/ghostty/overlay.conf by an overlay
# module. `?` makes it optional; the path is relative to this file's
# location as installed, which is the symlink, not the repo.
config-file = ?overlay.conf
