// Place your settings in this file to overwrite the default settings
// Useful references:
// - https://github.com/VSCodeVim/Vim
// - https://github.com/Melkeydev/vscode_bindings/tree/main
// - https://www.youtube.com/watch?v=GST8we5uABo
// - https://code.visualstudio.com/docs/getstarted/keybindings#_display
//
// Common to every machine. setup.sh merges this with the optional
// fragments beside it into VS Code's settings.json. See ../README.md.
{
  // ===========================================================================
  // GENERAL
  // ===========================================================================

  "diffEditor.renderSideBySide": false,
  "diffEditor.codeLens": true,
  "diffEditor.ignoreTrimWhitespace": true,
  "extensions.ignoreRecommendations": true,
  "files.autoSave": "onFocusChange",
  "files.eol": "\n",
  // Only open the Run and Debug view when a breakpoint is hit, and never pull
  // window focus for it (the debugger is driven from Vim chords).
  "debug.openDebug": "openOnDebugBreak",
  "debug.focusWindowOnBreak": false,
  "window.reopenFolders": "all",
  "window.restoreWindows": "all",
  "workbench.welcome.enabled": true,
  "workbench.startupEditor": "newUntitledFile",
  "workbench.editor.showTabs": "none",
  "[xml]": {},
  "[json]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "editor.suggestSelection": "first",
  "vsintellicode.modify.editor.suggestSelection": "automaticallyOverrodeDefaultValue",

  // ===========================================================================
  // THEMING AND APPEARANCE
  // ===========================================================================
  "breadcrumbs.enabled": true,
  "editor.fontFamily": "JetBrains Mono Nerd",
  "editor.fontSize": 12,
  "editor.lineNumbers": "relative",
  "editor.minimap.enabled": false,
  "editor.wordWrap": "on",
  "editor.cursorSurroundingLines": 8,
  "editor.padding.bottom": 300,
  "editor.scrollBeyondLastLine": false,
  "window.autoDetectColorScheme": true,
  "window.titleBarStyle": "custom",
  "window.zoomLevel": 2,
  "window.menuBarVisibility": "compact",
  "workbench.activityBar.location": "hidden",
  "workbench.colorTheme": "Visual Studio Light",
  "workbench.preferredDarkColorTheme": "KastorCode Dark Purple Theme",
  // "workbench.iconTheme": "material-icon-theme",
  //"workbench.preferredDarkColorTheme": "Deepdark Material Theme | Full Black Version",
  "zenMode.hideLineNumbers": false,
  "zenMode.fullScreen": false,
  "zenMode.hideStatusBar": false,

  // ===========================================================================
  // VIM CONFIGURATION
  // ===========================================================================

  "vim.leader": "<Space>",
  "vim.useCtrlKeys": true,
  "vim.easymotion": false,
  "vim.incsearch": true,
  "vim.hlsearch": true,
  "vim.surround": true,
  "vim.handleKeys": {
    "<C-d>": true,
    "<C-u>": true,
    "<C-a>": true,
    "<C-e>": true,
    "<C-y>": true,
    "<C-f>": true,
    "<C-b>": true,
    "<o>": true
  },
  "vim.insertModeKeyBindings": [],
  "vim.normalModeKeyBindings": [
    // DEBUGGER PREFIX (<leader>d -> fire-and-forget dispatch of <leader>d* chords)
    // VSCodeVim runs `remapping.commands` with `await` on a single `taskQueue`
    // (`remapper.ts`), so a 3-key chord bound straight to
    // `workbench.action.debug.start` freezes every Vim key until the preLaunch
    // build and the debug session have started. Instead `<leader>d` is a
    // recursive remap that buffers the synthetic `<plug-ldr-d>` key and sets the
    // `vim.leaderD` context, and keybindings.d/base.jsonc dispatches the third
    // key through VS Code's KeybindingService, outside `taskQueue`. The
    // `["<plug-ldr-d>", ...]` entries in vim.normalModeKeyBindingsNonRecursive
    // are the fallbacks VSCodeVim matches itself when the third key arrives
    // before the `setContext` RPC reaches the browser (fast typing), and
    // `["<plug-ldr-d>"]` alone resets the context after the 1s timeout or an
    // unmapped key (previously `<Space>d` + pause left Vim in operator-pending
    // `d`, so the next `j` deleted two lines). Avoid `d-`, `c-`, `s-` inside
    // `<plug-...>` names: VSCodeVim normalises them as modifiers.
    // -------------------------------------------------------------------------
    {
      "before": ["leader", "d"],
      "after": ["<plug-ldr-d>"],
      "commands": [
        {
          "command": "setContext",
          "args": ["vim.leaderD", true]
        }
      ],
      "silent": true
    }
  ],
  "vim.normalModeKeyBindingsNonRecursive": [
    // UNDO / REDO (Fix VSCodeVim undo tree desync)
    // -------------------------------------------------------------------------
    {
      "before": ["u"],
      "after": [],
      "commands": [{ "command": "undo" }]
    },
    {
      "before": ["<C-r>"],
      "after": [],
      "commands": [{ "command": "redo" }]
    },

    // SAVE & QUIT
    // -------------------------------------------------------------------------
    {
      "before": ["leader", "w"],
      "commands": ["workbench.action.files.save"]
    },
    {
      "before": ["leader", "q"],
      "commands": [":q"]
    },
    {
      "before": ["leader", "Q"],
      "commands": [":q!"]
    },

    // NAVIGATION & CENTERED SCROLLING (Neovim keymap.vim parity)
    // -------------------------------------------------------------------------
    {
      "before": ["C-f"],
      "after": ["C-f", "z", "z"]
    },
    {
      "before": ["C-b"],
      "after": ["C-b", "z", "z"]
    },
    {
      "before": ["C-e"],
      "after": ["C-e", "j"]
    },
    {
      "before": ["C-y"],
      "after": ["C-y", "k"]
    },
    {
      "before": ["n"],
      "after": ["n", "z", "z", "z", "v"]
    },
    {
      "before": ["N"],
      "after": ["N", "z", "z", "z", "v"]
    },
    {
      "before": ["C-n"],
      "commands": [":noh", "cancelSelection"]
    },
    // Jump list (<C-o> / <C-i>): VSCodeVim's own jump tracker ignores jumps made
    // through `remapping.commands` (e.g. `gd` -> editor.action.revealDefinition),
    // so route to VS Code's history service, which records every navigation.
    {
      "before": ["C-o"],
      "commands": ["workbench.action.navigateBack"]
    },
    {
      "before": ["C-i"],
      "commands": ["workbench.action.navigateForward"]
    },
    {
      "before": ["J"],
      "after": ["m", "z", "J", "`", "z"]
    },

    // CLIPBOARD, VOID REGISTER & PATH YANKING
    // -------------------------------------------------------------------------
    {
      "before": ["leader", "y"],
      "after": ["\"", "+", "y"]
    },
    {
      "before": ["leader", "Y"],
      "after": ["\"", "+", "Y"]
    },
    {
      "before": ["d", "D"],
      "after": ["\"", "_", "d"]
    },
    {
      "before": ["leader", "y", "p"],
      "commands": ["copyRelativeFilePath"]
    },
    {
      "before": ["leader", "y", "P"],
      "commands": ["copyFilePath"]
    },

    // SPLITS & BUFFERS (Neovim keymap.vim parity)
    // -------------------------------------------------------------------------
    // Create splits (<leader>h/j/k/l)
    {
      "before": ["leader", "h"],
      "commands": [":vsplit"]
    },
    {
      "before": ["leader", "l"],
      "commands": [":vsplit", "workbench.action.focusRightGroup"]
    },
    {
      "before": ["leader", "k"],
      "commands": [":split"]
    },
    {
      "before": ["leader", "j"],
      "commands": [":split", "workbench.action.focusBelowGroup"]
    },
    // Resize splits (<leader><leader>h/j/k/l)
    {
      "before": ["leader", "leader", "h"],
      "commands": ["workbench.action.decreaseViewWidth"]
    },
    {
      "before": ["leader", "leader", "l"],
      "commands": ["workbench.action.increaseViewWidth"]
    },
    {
      "before": ["leader", "leader", "k"],
      "commands": ["workbench.action.increaseViewHeight"]
    },
    {
      "before": ["leader", "leader", "j"],
      "commands": ["workbench.action.decreaseViewHeight"]
    },
    // Navigate between splits (<C-h/j/k/l>); `navigate*` also crosses from the
    // outermost split into the Sidebar / Panel like vim-tmux-navigator.
    {
      "before": ["c-h"],
      "commands": ["workbench.action.navigateLeft"]
    },
    {
      "before": ["c-l"],
      "commands": ["workbench.action.focusRightGroup"]
    },
    {
      "before": ["c-j"],
      "commands": ["workbench.action.navigateDown"]
    },
    {
      "before": ["c-k"],
      "commands": ["workbench.action.navigateUp"]
    },
    // Move editor across splits (<C-w>H/J/K/L)
    {
      "before": ["c-w", "H"],
      "commands": ["workbench.action.moveEditorToLeftGroup"]
    },
    {
      "before": ["c-w", "L"],
      "commands": ["workbench.action.moveEditorToRightGroup"]
    },
    {
      "before": ["c-w", "K"],
      "commands": ["workbench.action.moveEditorToAboveGroup"]
    },
    {
      "before": ["c-w", "J"],
      "commands": ["workbench.action.moveEditorToBelowGroup"]
    },
    // Switch between buffers (<S-h> / <S-l>, <C-[> / <C-]>)
    {
      "before": ["S-h"],
      "commands": [":bprevious"]
    },
    {
      "before": ["S-l"],
      "commands": [":bnext"]
    },
    {
      "before": ["C-["],
      "commands": [":bprevious"]
    },
    {
      "before": ["C-]"],
      "commands": [":bnext"]
    },

    // FILE EXPLORER (Neovim oil.nvim "\" parity)
    // -------------------------------------------------------------------------
    {
      "before": ["\\"],
      "commands": [
        "workbench.files.action.showActiveFileInExplorer",
        "workbench.explorer.fileView.focus"
      ]
    },

    // FIND & CODE INTELLIGENCE (Neovim Telescope parity)
    // -------------------------------------------------------------------------
    {
      "before": ["C-p"],
      "commands": ["workbench.action.quickOpen"]
    },
    {
      "before": ["leader", "e"],
      "commands": ["workbench.action.quickOpen"]
    },
    {
      "before": ["leader", "t"],
      "commands": ["workbench.action.gotoSymbol"]
    },
    {
      "before": ["leader", "leader", "t"],
      "commands": ["breadcrumbs.focusAndSelect"]
    },
    {
      "before": ["leader", "f", "f"],
      "commands": ["workbench.action.quickOpen"]
    },
    {
      "before": ["leader", "f", "p"],
      "commands": ["workbench.action.findInFiles"]
    },
    {
      "before": ["leader", "f", "g"],
      "commands": ["workbench.action.findInFiles"]
    },
    {
      "before": ["leader", "f", "r"],
      "commands": ["workbench.action.replaceInFiles"]
    },
    {
      "before": ["leader", "f", "s"],
      "commands": ["workbench.action.showAllSymbols"]
    },
    // `editor.action.findReferences` is programmatic-only (asserts on its uri /
    // position arguments); `goToReferences` peeks references at the cursor.
    {
      "before": ["leader", "f", "u"],
      "commands": ["editor.action.goToReferences"]
    },
    {
      "before": ["leader", "f", "i"],
      "commands": ["editor.action.goToImplementation"]
    },
    {
      "before": ["leader", "f", "c"],
      "commands": ["editor.action.goToTypeDefinition"]
    },
    {
      "before": ["leader", "f", "w"],
      "commands": ["workbench.action.openRecent"]
    },
    {
      "before": ["g", "d"],
      "commands": ["editor.action.revealDefinition"]
    },

    // LSP INFO, DIAGNOSTICS & FORMATTING (Neovim lsp.lua / trouble.lua parity)
    // -------------------------------------------------------------------------
    // Hover / diagnostic tooltip: first press shows it, second press moves focus
    // into it (`editorHoverFocused`, Vim scrolling in keybindings.d/base.jsonc).
    {
      "before": ["leader", "s", "h"],
      "commands": [
        {
          "command": "editor.action.showHover",
          "args": { "focus": "focusIfVisible" }
        }
      ]
    },
    {
      "before": ["leader", "s", "e"],
      "commands": [
        {
          "command": "editor.action.showHover",
          "args": { "focus": "focusIfVisible" }
        }
      ]
    },
    {
      "before": ["leader", "s", "d"],
      "commands": ["workbench.actions.view.problems"]
    },
    {
      "before": ["leader", "s", "r"],
      "commands": ["editor.action.changeAll"]
    },
    {
      "before": ["leader", "n"],
      "commands": ["editor.action.marker.next"]
    },
    {
      "before": ["leader", "N"],
      "commands": ["editor.action.marker.prev"]
    },
    {
      "before": ["[", "t"],
      "commands": ["editor.action.marker.prev"]
    },
    {
      "before": ["]", "t"],
      "commands": ["editor.action.marker.next"]
    },
    {
      "before": ["leader", "leader", "f"],
      "commands": ["editor.action.formatDocument"]
    },
    {
      "before": ["leader", "r", "n"],
      "commands": ["editor.action.rename"]
    },
    {
      "before": ["leader", "c", "a"],
      "commands": ["editor.action.quickFix"]
    },
    // Review comment threads (VS Code comments API)
    {
      "before": ["leader", "c", "l"],
      "commands": ["editor.action.nextCommentThreadAction"]
    },
    {
      "before": ["leader", "c", "L"],
      "commands": ["workbench.action.focusCommentsPanel"]
    },

    // BUILD, TEST & DEBUG (Neovim build.lua & dap.lua parity)
    // -------------------------------------------------------------------------
    {
      "before": ["leader", "b", "t"],
      "commands": ["testing.runAtCursor"]
    },
    {
      "before": ["leader", "b", "T"],
      "commands": ["testing.runCurrentFile"]
    },
    {
      "before": ["leader", "b", "r"],
      "commands": ["testing.reRunLastRun"]
    },
    {
      "before": ["leader", "b", "l"],
      "commands": ["workbench.view.extension.test"]
    },
    {
      "before": ["leader", "leader", "c"],
      "commands": ["workbench.action.tasks.runTask"]
    },
    // DEBUGGER (<leader>d*): fallbacks for the <plug-ldr-d> dispatch declared in
    // vim.normalModeKeyBindings above; the primary path is keybindings.d/base.jsonc.
    {
      "before": ["<plug-ldr-d>"],
      "commands": [
        {
          "command": "setContext",
          "args": ["vim.leaderD", false]
        }
      ],
      "silent": true
    },
    {
      "before": ["<plug-ldrd-ok>"],
      "commands": [
        {
          "command": "setContext",
          "args": ["vim.leaderD", false]
        }
      ],
      "silent": true
    },
    // Dummy 2-key remap: a fallback's `after: ["<plug-ldr-clr>", ...]` breaks this
    // potential remap so VSCodeVim clears
    // `wasPerformingRemapThatFinishedWaitingForTimeout` (remapper.ts) instead of
    // slicing keys off the next chord. Shared by every <plug-ldr-*> prefix.
    {
      "before": ["<plug-ldr-clr>", "<plug-ldr-never>"],
      "commands": [],
      "silent": true
    },
    {
      "before": ["<plug-ldr-d>", "d"],
      "after": ["<plug-ldr-clr>", "<plug-ldrd-ok>"],
      "commands": [
        {
          "command": "setContext",
          "args": ["vim.leaderD", false]
        },
        "workbench.action.debug.start"
      ],
      "silent": true
    },
    {
      "before": ["<plug-ldr-d>", "a"],
      "after": ["<plug-ldr-clr>", "<plug-ldrd-ok>"],
      "commands": [
        {
          "command": "setContext",
          "args": ["vim.leaderD", false]
        },
        "workbench.action.debug.selectandstart"
      ],
      "silent": true
    },
    {
      "before": ["<plug-ldr-d>", "t"],
      "after": ["<plug-ldr-clr>", "<plug-ldrd-ok>"],
      "commands": [
        {
          "command": "setContext",
          "args": ["vim.leaderD", false]
        },
        "testing.debugAtCursor"
      ],
      "silent": true
    },
    {
      "before": ["<plug-ldr-d>", "T"],
      "after": ["<plug-ldr-clr>", "<plug-ldrd-ok>"],
      "commands": [
        {
          "command": "setContext",
          "args": ["vim.leaderD", false]
        },
        "testing.debugCurrentFile"
      ],
      "silent": true
    },
    {
      "before": ["<plug-ldr-d>", "b"],
      "after": ["<plug-ldr-clr>", "<plug-ldrd-ok>"],
      "commands": [
        {
          "command": "setContext",
          "args": ["vim.leaderD", false]
        },
        "editor.debug.action.toggleBreakpoint"
      ],
      "silent": true
    },
    {
      "before": ["<plug-ldr-d>", "B"],
      "after": ["<plug-ldr-clr>", "<plug-ldrd-ok>"],
      "commands": [
        {
          "command": "setContext",
          "args": ["vim.leaderD", false]
        },
        "editor.debug.action.conditionalBreakpoint"
      ],
      "silent": true
    },
    {
      "before": ["<plug-ldr-d>", "c"],
      "after": ["<plug-ldr-clr>", "<plug-ldrd-ok>"],
      "commands": [
        {
          "command": "setContext",
          "args": ["vim.leaderD", false]
        },
        "workbench.action.debug.continue"
      ],
      "silent": true
    },
    {
      "before": ["<plug-ldr-d>", "o"],
      "after": ["<plug-ldr-clr>", "<plug-ldrd-ok>"],
      "commands": [
        {
          "command": "setContext",
          "args": ["vim.leaderD", false]
        },
        "workbench.action.debug.stepOver"
      ],
      "silent": true
    },
    {
      "before": ["<plug-ldr-d>", "i"],
      "after": ["<plug-ldr-clr>", "<plug-ldrd-ok>"],
      "commands": [
        {
          "command": "setContext",
          "args": ["vim.leaderD", false]
        },
        "workbench.action.debug.stepInto"
      ],
      "silent": true
    },
    {
      "before": ["<plug-ldr-d>", "O"],
      "after": ["<plug-ldr-clr>", "<plug-ldrd-ok>"],
      "commands": [
        {
          "command": "setContext",
          "args": ["vim.leaderD", false]
        },
        "workbench.action.debug.stepOut"
      ],
      "silent": true
    },
    {
      "before": ["<plug-ldr-d>", "f"],
      "after": ["<plug-ldr-clr>", "<plug-ldrd-ok>"],
      "commands": [
        {
          "command": "setContext",
          "args": ["vim.leaderD", false]
        },
        "workbench.debug.action.focusCallStackView"
      ],
      "silent": true
    },
    {
      "before": ["<plug-ldr-d>", "h"],
      "after": ["<plug-ldr-clr>", "<plug-ldrd-ok>"],
      "commands": [
        {
          "command": "setContext",
          "args": ["vim.leaderD", false]
        },
        "editor.debug.action.showDebugHover"
      ],
      "silent": true
    },
    {
      "before": ["<plug-ldr-d>", "e"],
      "after": ["<plug-ldr-clr>", "<plug-ldrd-ok>"],
      "commands": [
        {
          "command": "setContext",
          "args": ["vim.leaderD", false]
        },
        "editor.debug.action.selectionToWatch"
      ],
      "silent": true
    },
    {
      "before": ["<plug-ldr-d>", "r"],
      "after": ["<plug-ldr-clr>", "<plug-ldrd-ok>"],
      "commands": [
        {
          "command": "setContext",
          "args": ["vim.leaderD", false]
        },
        "workbench.action.debug.restart"
      ],
      "silent": true
    },
    {
      "before": ["<plug-ldr-d>", "x"],
      "after": ["<plug-ldr-clr>", "<plug-ldrd-ok>"],
      "commands": [
        {
          "command": "setContext",
          "args": ["vim.leaderD", false]
        },
        "workbench.action.debug.stop"
      ],
      "silent": true
    },
    {
      "before": ["<plug-ldr-d>", "D"],
      "after": ["<plug-ldr-clr>", "<plug-ldrd-ok>"],
      "commands": [
        {
          "command": "setContext",
          "args": ["vim.leaderD", false]
        },
        "workbench.action.debug.disconnect"
      ],
      "silent": true
    },
    {
      "before": ["<plug-ldr-d>", "u"],
      "after": ["<plug-ldr-clr>", "<plug-ldrd-ok>"],
      "commands": [
        {
          "command": "setContext",
          "args": ["vim.leaderD", false]
        },
        "workbench.debug.action.toggleRepl"
      ],
      "silent": true
    },
    {
      "before": ["<plug-ldr-d>", "v"],
      "after": ["<plug-ldr-clr>", "<plug-ldrd-ok>"],
      "commands": [
        {
          "command": "setContext",
          "args": ["vim.leaderD", false]
        },
        "workbench.view.debug"
      ],
      "silent": true
    },

    // VCS / GIT & DIFF NAVIGATION (Neovim fugitive / vim-signify parity)
    // -------------------------------------------------------------------------
    {
      "before": ["leader", "v", "s"],
      "commands": ["workbench.view.scm"]
    },
    {
      "before": ["leader", "v", "b"],
      "commands": ["git.timeline.open"]
    },
    {
      "before": ["leader", "v", "d"],
      "commands": ["git.openChange"]
    },
    {
      "before": ["leader", "v", "n"],
      "commands": [
        "workbench.action.editor.nextChange",
        "workbench.action.compareEditor.nextChange"
      ]
    },
    {
      "before": ["leader", "v", "N"],
      "commands": [
        "workbench.action.editor.previousChange",
        "workbench.action.compareEditor.previousChange"
      ]
    },
    {
      "before": ["leader", "v", "p"],
      "commands": [
        "workbench.action.editor.previousChange",
        "workbench.action.compareEditor.previousChange"
      ]
    },
    {
      "before": ["[", "c"],
      "commands": [
        "workbench.action.editor.previousChange",
        "workbench.action.compareEditor.previousChange"
      ]
    },
    {
      "before": ["]", "c"],
      "commands": [
        "workbench.action.editor.nextChange",
        "workbench.action.compareEditor.nextChange"
      ]
    },
    {
      "before": ["leader", "p"],
      "commands": ["git.push"]
    },
    {
      "before": ["leader", "P"],
      "commands": ["git.pullRebase"]
    },

    // OTHER / UI
    // -------------------------------------------------------------------------
    {
      "before": ["leader", "z"],
      "commands": ["workbench.action.toggleZenMode"]
    },
    {
      "before": ["leader", "u"],
      "commands": ["timeline.focus"]
    },
    {
      "before": ["leader", "v", "t"],
      "commands": ["workbench.action.toggleActivityBarVisibility"]
    }
  ],
  "vim.visualModeKeyBindings": [
    // Stay in visual mode while indenting
    {
      "before": ["<"],
      "commands": ["editor.action.outdentLines"]
    },
    {
      "before": [">"],
      "commands": ["editor.action.indentLines"]
    },
    // Move selected lines while staying in visual mode
    {
      "before": ["J"],
      "commands": ["editor.action.moveLinesDownAction"]
    },
    {
      "before": ["K"],
      "commands": ["editor.action.moveLinesUpAction"]
    },
    // Clipboard yank, paste without overwriting clipboard, void delete
    {
      "before": ["leader", "y"],
      "after": ["\"", "+", "y"]
    },
    {
      "before": ["leader", "p"],
      "after": ["\"", "_", "d", "P"]
    },
    {
      "before": ["y", "D"],
      "after": ["\"", "_", "y", "d"]
    },
    // Exit Visual mode, clear search highlight and selection
    {
      "before": ["C-n"],
      "after": ["<Esc>"],
      "commands": [":noh", "cancelSelection"]
    },
    // Debug hover & add selection to watch
    {
      "before": ["leader", "d", "h"],
      "commands": ["editor.debug.action.showDebugHover"]
    },
    {
      "before": ["leader", "d", "e"],
      "commands": ["editor.debug.action.selectionToWatch"]
    }
  ],
  // To improve performance
  "extensions.experimental.affinity": {
    "vscodevim.vim": 1
  },
  "git.openRepositoryInParentFolders": "always"
}
