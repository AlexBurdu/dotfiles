// Merged into settings.json by setup.sh, only on a machine whose machine.sh
// says `enable bazel`. See ../README.md.
{
  // BAZEL
  // ---------------------------------------------------------------------------
  "bazel.executable": "./bazelw",
  "bazel.buildifierFixOnFormat": true,
  // Space gb: open the BUILD file that owns the current source (Neovim
  // build_nav.lua / IdeaVim parity).
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": ["leader", "g", "b"],
      "commands": ["bazel.goToBuildFile"]
    }
  ],
  "settingsSync.ignoredSettings": [
    "-bazel.executable",
    "-bazel.buildifierExecutable"
  ]
}
